{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/", "destination": "/timesheet/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/timesheet/api/:path*", "destination": "/api/:path*" },
    { "source": "/timesheet", "destination": "/timesheet/index.html" },
    { "source": "/timesheet/((?!api/|.*\\.).*)", "destination": "/timesheet/index.html" }
  ]
}
